[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/pause_menu.gd" id="1"]
[ext_resource type="Script" path="res://scenes/ui/ui_button.gd" id="2"]

[node name="PauseMenu" type="Control"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Panel" type="MarginContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_right = 240.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 46
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 36

[node name="Body" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 20

[node name="Head" type="HBoxContainer" parent="Panel/Body"]

[node name="Heading" type="Label" parent="Panel/Body/Head"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = "試験一時停止"
vertical_alignment = 2

[node name="Sub" type="Label" parent="Panel/Body/Head"]
unique_name_in_owner = true
size_flags_vertical = 8
text = "PAUSE"

[node name="Menu" type="VBoxContainer" parent="Panel/Body"]
unique_name_in_owner = true
theme_override_constants/separation = 12

[node name="Resume" type="Button" parent="Panel/Body/Menu"]
unique_name_in_owner = true
text = "再開"
script = ExtResource("2")
primary = true
on_ink = false
key_hint = "Esc"

[node name="Retry" type="Button" parent="Panel/Body/Menu"]
unique_name_in_owner = true
text = "リトライ"
script = ExtResource("2")
on_ink = false
key_hint = "R"

[node name="Settings" type="Button" parent="Panel/Body/Menu"]
unique_name_in_owner = true
text = "設定"
script = ExtResource("2")
on_ink = false

[node name="Select" type="Button" parent="Panel/Body/Menu"]
unique_name_in_owner = true
text = "ステージ選択へ"
script = ExtResource("2")
on_ink = false

[node name="Help" type="Label" parent="Panel/Body"]
unique_name_in_owner = true
text = "↑↓ 選択　　SPACE / クリック 決定"
